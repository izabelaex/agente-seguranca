# Copie este arquivo para .env e preencha com seus valores reais
# O arquivo .env nunca deve ser commitado no repositório

# Chave individual fornecida pelo professor para o servidor Ollama
LLM_API_KEY=sua-chave-aqui

# LangSmith — rastreamento e observabilidade (opcional mas recomendado)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=sua-chave-langsmith-aqui
LANGCHAIN_PROJECT=agente-seguranca
